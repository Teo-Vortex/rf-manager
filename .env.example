# The only required value is normally the MQTT broker address.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=rf-manager
TASMOTA_RECEIVE_TOPIC=tele/+/RESULT
TASMOTA_COMMAND_TOPIC=cmnd/rfbridge/
RF_DUPLICATE_WINDOW_MS=300
RF_EVENT_RETENTION_DAYS=30
APP_PORT=8765
LOG_LEVEL=INFO
